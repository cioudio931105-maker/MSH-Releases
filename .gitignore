# Microscope-Scanner-Helper_MSH
# Generated data and large research artifacts must be preserved externally.
# Do not delete files merely because they are ignored by Git.

# ----------------------------------------------------------------------
# Python / Conda virtual environments
# ----------------------------------------------------------------------
.venv/
.venv*/
venv/
env/
ENV/
.conda/
.conda-*/
conda-env/
pip-wheel-metadata/

# ----------------------------------------------------------------------
# Python caches and tooling
# ----------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.ipynb_checkpoints/

# ----------------------------------------------------------------------
# Local editor, IDE and user-specific state
# ----------------------------------------------------------------------
.vscode/
.idea/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
.agents/
.cell_project_install.json
.matplotlib/
.ultralytics/

# ----------------------------------------------------------------------
# Logs, caches and temporary files
# ----------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*.cache
*.pid
*.lock
~$*
tmp/
temp/
cache/
.cache/

