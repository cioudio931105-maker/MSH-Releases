# ----------------------------------------------------------------------
# Root runtime output and training runs
# ----------------------------------------------------------------------
/output/
/session_output/
/staging/
/runs/
/backups/

# ----------------------------------------------------------------------
# Project runtime output
# Keep placeholder files where the source tree requires the directories.
# ----------------------------------------------------------------------
/cell_stitching_project/output/**
!/cell_stitching_project/output/.gitkeep
/cell_stitching_project/debug/**
!/cell_stitching_project/debug/.gitkeep

# ----------------------------------------------------------------------
# Standalone/offline analysis generated artifacts
# Source code under offline_cell_analysis remains eligible for Git.
# ----------------------------------------------------------------------
/offline_cell_analysis/build/
/offline_cell_analysis/dist/
/offline_cell_analysis/OfflineCellAnalysis_*_dir/
/offline_cell_analysis/outputs/
/offline_cell_analysis/output/
/offline_cell_analysis/cropped_cells/
/offline_cell_analysis/cropped_cells_single/
/offline_cell_analysis/training_datasets/
/offline_cell_analysis/videos/
/offline_cell_analysis/detections/**
!/offline_cell_analysis/detections/.gitkeep
/offline_cell_analysis/extracted_frames/**
!/offline_cell_analysis/extracted_frames/.gitkeep

# ----------------------------------------------------------------------
# Large datasets
# Preserve these outside ordinary Git; do not delete them.
# ----------------------------------------------------------------------
/datasets/
/dataset/
/data/raw/
/data/datasets/
/data/training/
/data/validation/

# Dataset copies embedded in project trees
/cell_stitching_project/data/**
!/cell_stitching_project/data/.gitkeep

