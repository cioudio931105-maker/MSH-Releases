# ----------------------------------------------------------------------
# stitched_output mixed legacy tree
#
# IMPORTANT:
# Do not ignore /stitched_output/ as a whole. It contains legacy source,
# GUI, Arduino/XY hardware code, camera configuration and documentation.
# ----------------------------------------------------------------------

# Outer runtime results
/stitched_output/CON
/stitched_output/captured_steps/
/stitched_output/output/
/stitched_output/runs/

# Intermediate nested runtime results
/stitched_output/stitched_output/captured_steps/
/stitched_output/stitched_output/output/
/stitched_output/stitched_output/runs/
/stitched_output/stitched_output/stitch_log.txt

# Nested legacy runtime/data/model results
/stitched_output/stitched_output/stitched_output/1/
/stitched_output/stitched_output/stitched_output/captured/
/stitched_output/stitched_output/stitched_output/captured_steps/
/stitched_output/stitched_output/stitched_output/data/
/stitched_output/stitched_output/stitched_output/experiments/
/stitched_output/stitched_output/stitched_output/models/
/stitched_output/stitched_output/stitched_output/output/
/stitched_output/stitched_output/stitched_output/outputs/
/stitched_output/stitched_output/stitched_output/runs/
/stitched_output/stitched_output/stitched_output/stitched_results/
/stitched_output/stitched_output/stitched_output/scripts/stitch_log.txt
/stitched_output/stitched_output/stitched_output/stitch_log.txt

# Legacy generated logs/caches, regardless of location
/stitched_output/**/__pycache__/
/stitched_output/**/*.pyc
/stitched_output/**/*.log
/stitched_output/**/*.cache

# ----------------------------------------------------------------------
# Operating-system files
# ----------------------------------------------------------------------
